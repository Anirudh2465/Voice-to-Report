<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ modality }} Report — {{ patient_name }}</title>
  <link rel="stylesheet" href="../styles/letterhead.css" />
</head>
<body>

  <!-- Letterhead -->
  <div class="letterhead">
    <div>
      <div class="institution-name">{{ institution }}</div>
      <div style="font-size:9pt; color:#718096;">Department of Radiology &amp; Imaging</div>
    </div>
    <div class="radiologist-info">
      <strong>{{ radiologist_name }}</strong><br/>
      {{ designation }}<br/>
      {{ date }}
    </div>
  </div>

  <!-- Report Title -->
  <div class="report-title">{% block report_title %}Radiology Report{% endblock %}</div>

  <!-- Patient Info -->
  <table class="patient-info">
    <tr>
      <td>Patient</td><td>{{ patient_name }}</td>
      <td>Patient ID</td><td>{{ patient_id }}</td>
    </tr>
    <tr>
      <td>Modality</td><td>{{ modality }}</td>
      <td>Referring Dr.</td><td>{{ referring_doctor }}</td>
    </tr>
  </table>

  <!-- Report Sections -->
  {% block sections %}
  {% if report_content.clinical_history %}
  <div class="section">
    <div class="section-title">Clinical History</div>
    <div class="section-content">{{ report_content.clinical_history }}</div>
  </div>
  {% endif %}

  {% if report_content.technique %}
  <div class="section">
    <div class="section-title">Technique</div>
    <div class="section-content">{{ report_content.technique }}</div>
  </div>
  {% endif %}

  {% if report_content.findings %}
  <div class="section">
    <div class="section-title">Findings</div>
    <div class="section-content">{{ report_content.findings }}</div>
  </div>
  {% endif %}

  {% if report_content.impression %}
  <div class="section">
    <div class="section-title">Impression</div>
    <div class="section-content">{{ report_content.impression }}</div>
  </div>
  {% endif %}

  {% if report_content.recommendations %}
  <div class="section">
    <div class="section-title">Recommendations</div>
    <div class="section-content">{{ report_content.recommendations }}</div>
  </div>
  {% endif %}
  {% endblock %}

  <!-- Signature -->
  <div class="signature-block">
    <div class="signature-name">Dr. {{ radiologist_name }}</div>
    <div class="signature-designation">{{ designation }}</div>
    <div class="signature-designation">{{ institution }}</div>
  </div>

  <!-- Footer -->
  <div class="report-footer">
    <span>Generated by Voice-to-Report</span>
    <span>{{ date }}</span>
    <span>Confidential — For Medical Use Only</span>
  </div>

</body>
</html>
